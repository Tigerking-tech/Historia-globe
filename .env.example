DATABASE_URL="file:./dev.db" #Do not change

# ---- Payments (optional) ----
# 收款默认关闭。只有在下面三项都按真实商户配置后才会启用 live 结账：
#   CREEM_MODE=live + 正式环境的 CREEM_API_KEY + 对应的 CREEM_PRODUCT_<SKU> 商品 id。
# 未配置时 /api/checkout 返回 503、/api/products 返回 enabled:false，定价页明确显示「结账未启用」。
# 绝不把 test 通道当作能收真钱。
CREEM_API_KEY=""                 # 正式 key；留空即禁用收款
CREEM_MODE="disabled"           # disabled | test | live  （仅 live 会创建真实结账）
CREEM_API_URL=""                # 可选，自定义 Creem API 地址
# CREEM_PRODUCT_ARCHIVAL_PASS="" # 一次性 $4 通行证在 Creem 后台的商品 id
SUCCESS_URL=http://localhost:3000/account # 购买成功回跳

# ---- Support / 合规 ----
# 隐私/退款/条款/联系页会展示该邮箱；未显式设置时会如实标注「需验证可达」，
# 并给出一个始终可达的 GitHub Issues 兜底渠道。
SUPPORT_EMAIL=""

# ---- Auth ----
BETTER_AUTH_SECRET="supersecretstring" #Use any random string as your secret
BETTER_AUTH_URL=http://localhost:3000 #Base URL of your app

# ---- AI（可选）----
# 无 key 时自动降级为本地事件串联，不外呼。免费层另有 token 配额护栏（lib/quota.ts）。
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ---- 可观测性（可选）----
# 漏斗与 AI 爬虫日志的落盘目录；Serverless 只读文件系统会自动降级为内存 + 结构化日志。
OBS_DATA_DIR=""
